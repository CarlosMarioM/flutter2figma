{
  "name": "flutter2figma-figma-plugin",
  "private": true,
  "version": "0.1.0",
  "description": "Imports Flutter2Figma design.json files into Figma as editable, auto-layout frames.",
  "scripts": {
    "build": "esbuild src/code.ts --bundle --target=es2017 --outfile=dist/code.js",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/importer.test.ts --bundle --platform=node --format=esm --outfile=dist/test/importer.test.mjs && node --test dist/test/importer.test.mjs",
    "package": "scripts/package.sh"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.139.0",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}

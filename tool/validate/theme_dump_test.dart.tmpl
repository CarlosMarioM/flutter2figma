String hex(f.Color? c) {
  if (c == null) return 'null';
  final argb = c.toARGB32();
  String h(int v) => v.toRadixString(16).padLeft(2, '0');
  final a = (argb >> 24) & 0xff;
  return '#${h((argb >> 16) & 0xff)}${h((argb >> 8) & 0xff)}${h(argb & 0xff)}${a == 0xff ? '' : h(a)}'
      .toUpperCase();
}

